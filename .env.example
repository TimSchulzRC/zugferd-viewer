# Public URL of the app, without trailing slash
APP_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# First administrator. This address can always sign in and invite others.
ADMIN_EMAIL=

DATABASE_URL=postgres://zugferd:zugferd@localhost:5433/zugferd
VALIDATOR_URL=http://localhost:8080

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=zugferd
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
# S3_REGION=us-east-1

# Without a token, mails are printed to the server log instead of being sent.
LETTERMINT_TOKEN=
MAIL_FROM=ZUGFeRD Viewer <noreply@example.com>

# Microsoft sign-in is offered once all three are set. The tenant must be your own
# (not "common"), because invitations are matched by e-mail address.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
